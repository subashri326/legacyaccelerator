FROM python:3.11-slim-bookworm

WORKDIR /app
# git for wave delivery; unixODBC + Microsoft ODBC Driver 18 for SQL Server / Fabric connections.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl gnupg ca-certificates unixodbc \
 && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
 && echo "deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" > /etc/apt/sources.list.d/mssql-release.list \
 && apt-get update && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md alembic.ini ./
COPY alembic ./alembic
COPY src ./src
COPY examples ./examples

RUN pip install --no-cache-dir -e ".[connectors,orchestration]"

EXPOSE 8000 8501
CMD ["uvicorn", "accelerator.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
