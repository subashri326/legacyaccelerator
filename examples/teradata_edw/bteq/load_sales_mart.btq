.LOGON tdprod/etl_user,$TD_PASSWORD;
.SET WIDTH 200
.SET ERROROUT STDOUT

DATABASE EDW;

/* Rebuild the customer sales mart */
DEL FROM EDW.SALES_MART ALL;
.IF ERRORCODE <> 0 THEN .QUIT 8

INS INTO EDW.SALES_MART (CUST_ID, TOTAL_AMT, SALE_CNT)
SEL CUST_ID, SUM(ZEROIFNULL(AMT)), COUNT(*)
FROM EDW.SALES_FACT
GROUP BY 1;
.IF ERRORCODE <> 0 THEN .QUIT 8

COLLECT STATISTICS ON EDW.SALES_MART COLUMN (CUST_ID);

.EXPORT REPORT FILE = /data/out/sales_mart.txt
SEL * FROM EDW.SALES_MART ORDER BY CUST_ID;
.EXPORT RESET

.LOGOFF
.QUIT 0
