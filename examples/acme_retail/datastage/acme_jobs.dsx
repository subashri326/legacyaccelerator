      OLEType "CTransformerStage"
      Readonly "0"
      Name "Xfm_Classify"
      NextID "3"
      InputPins "V0S3P1"
      OutputPins "V0S3P2|V0S3P3|V0S3P4"
      StageType "CTransformerStage"
      AllowColumnMapping "0"
      StageVars "CStageVar"
      BEGIN DSSUBRECORD
         Name "svNet"
         Expression "If IsNull(lnk_enriched.discount) Then lnk_enriched.gross_amount Else lnk_enriched.gross_amount - lnk_enriched.discount"
         ParsedExpression "If IsNull(lnk_enriched.discount) Then lnk_enriched.gross_amount Else lnk_enriched.gross_amount - lnk_enriched.discount"
         SqlType "3"
         Precision "14"
         Scale "2"
         InitialValue ""
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "svBand"
         Expression "If svNet >= 300 Then 'LARGE' Else If svNet >= 100 Then 'MEDIUM' Else 'SMALL'"
         ParsedExpression "If svNet >= 300 Then 'LARGE' Else If svNet >= 100 Then 'MEDIUM' Else 'SMALL'"
         SqlType "12"
         Precision "10"
         Scale "0"
         InitialValue ""
