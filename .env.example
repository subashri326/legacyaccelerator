# Database (defaults to local SQLite for zero-config dev; set PostgreSQL URL for production)
L2C_DATABASE_URL=sqlite:///./.l2c_data/accelerator.db
# L2C_DATABASE_URL=postgresql+psycopg2://l2c:l2c@localhost:5432/l2c_metadata

# Artifact Store (local | s3 | adls)
L2C_STORAGE_BACKEND=local
L2C_STORAGE_LOCAL_ROOT=./.l2c_data/artifacts

# Secrets Vault (local | env | hashicorp)
L2C_VAULT_BACKEND=local
L2C_VAULT_LOCAL_FILE=./.l2c_data/vault.json

# Auth / OIDC
L2C_JWT_SECRET=change-me-in-production-use-32-plus-bytes
L2C_AUTH_MODE=local
# L2C_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0

# Optional AI Assist (opt-in per client config; never sends data rows)
L2C_AI_ENABLED=false
L2C_AI_ENDPOINT=http://localhost:11434/v1/chat/completions
L2C_AI_MODEL=llama3.1
# L2C_AI_API_KEY=

# Data Privacy / L4 Diff Retention
L2C_L4_SAMPLE_RETENTION_DAYS=7
